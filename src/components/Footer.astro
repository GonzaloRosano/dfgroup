---
import { getLines } from '../data/lines';
import { getTranslations, localizedPath, type Locale } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const lines = getLines(lang);
const base = localizedPath(lang, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__brand">
        <img class="site-footer__logo" src="/logo.svg" alt="" width="22" height="24" />
        Dark Feather Group
      </p>
    </div>

    <nav aria-label={t.nav.linesAriaLabel}>
      <p class="site-footer__label">{t.footer.productos}</p>
      <ul>
        {lines.map((line) => (
          <li>
            <a href={`${base}#${line.slug}`}>{line.code}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label={t.footer.grupo}>
      <p class="site-footer__label">{t.footer.grupo}</p>
      <ul>
        <li><a href={`${base}#grupo`}>{t.footer.sobreNosotros}</a></li>
        <li><a href={`${base}#contacto`}>{t.footer.contacto}</a></li>
        <li><a href={localizedPath(lang, 'privacidad')}>{t.footer.privacidad}</a></li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__meta">
    <p>{t.footer.copyright(year)}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    /* .home-atmosphere is position:fixed, so it stays on screen behind
       whatever else is in the viewport, including the footer once you
       scroll that far — without its own background the footer is on top
       for stacking/hit-testing but the canvas still shows through every
       gap (padding, gutters, letterforms) where the footer paints nothing. */
    background: var(--void);
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding-block: var(--space-lg) var(--space-md);
    margin-top: auto;
    /* Mandatory snap needs a valid landing point past #contacto, or it
       springs back before the (shorter-than-viewport) footer is reachable. */
    scroll-snap-align: end;
  }

  .site-footer__grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .site-footer__logo {
    width: 1.35rem;
    height: auto;
    filter: invert(1);
  }

  .site-footer__note,
  .site-footer__meta {
    color: var(--mute);
    font-size: 0.9rem;
  }

  .site-footer__label {
    color: var(--mute);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .site-footer a {
    color: var(--fog);
    transition: color 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer a:hover {
      color: var(--bone);
    }
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>

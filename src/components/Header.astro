---
import { lines } from '../data/lines';

const navLinks = [
  { href: '/#grupo', label: 'Grupo' },
  { href: '/#lineas', label: 'Líneas' },
  { href: '/#oficio', label: 'Oficio' },
  { href: '/#contacto', label: 'Contacto' },
];

const lineSlugs = lines.map((line) => line.slug);
---

<header class="site-header" data-site-header>
  <div class="nav-bar" data-nav-bar>
    <a class="brand" href="/#inicio" aria-label="Dark Feather Group — inicio">
      <span class="brand__mark" aria-hidden="true">
        <img class="brand__logo" src="/logo.svg" alt="" width="20" height="22" />
      </span>
      <span class="brand__lockup">
        <span class="brand__name">Dark Feather</span>
        <span class="brand__suffix">Group</span>
      </span>
    </a>

    <nav class="nav" aria-label="Principal">
      {navLinks.map((link) => (
        <a class="nav__link" href={link.href} data-nav-link>
          <span class="nav__link-text">{link.label}</span>
        </a>
      ))}
    </nav>

    <a class="nav__cta" href="/#contacto" data-nav-link>
      <span class="nav__cta-text">Empezar proyecto</span>
      <span class="nav__cta-arrow" aria-hidden="true">→</span>
    </a>

    <button
      class="nav__menu-btn"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-overlay"
      data-menu-toggle
    >
      <span class="nav__menu-icon" aria-hidden="true">
        <span class="nav__menu-line"></span>
        <span class="nav__menu-line"></span>
      </span>
      <span class="nav__menu-label">Menú</span>
    </button>
  </div>

  <div
    class="menu-overlay"
    id="menu-overlay"
    data-menu-overlay
    data-open="false"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    hidden
  >
    <button class="menu-overlay__close" type="button" aria-label="Cerrar menú" data-menu-close>
      <span class="nav__menu-icon nav__menu-icon--close" aria-hidden="true">
        <span class="nav__menu-line"></span>
        <span class="nav__menu-line"></span>
      </span>
    </button>

    <div class="menu-overlay__inner">
      <nav class="menu-overlay__nav" aria-label="Menú completo">
        <a href="/#inicio" data-menu-link data-nav-link>
          <span>Inicio</span>
        </a>
        {navLinks.map((link, i) => (
          <a href={link.href} data-menu-link data-nav-link style={`--menu-i: ${i + 1}`}>
            <span>{link.label}</span>
          </a>
        ))}
        <div class="menu-overlay__lines" aria-label="Líneas del grupo">
          {lines.map((line, i) => (
            <a href={`/#${line.slug}`} data-menu-link data-nav-link style={`--menu-i: ${i + navLinks.length + 1}`}>
              <span class="menu-overlay__line-code">{line.code}</span>
            </a>
          ))}
        </div>
      </nav>

      <div class="menu-overlay__contact">
        <p class="menu-overlay__label">Consultas</p>
        <a class="menu-overlay__email" href="mailto:hola@darkfeathergroup.com">
          hola@darkfeathergroup.com
        </a>
        <a class="menu-overlay__talk" href="/#contacto" data-menu-link>Empezar proyecto</a>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ lineSlugs }}>
  const header = document.querySelector('[data-site-header]');
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const menuClose = document.querySelector('[data-menu-close]');
  const menuOverlay = document.querySelector('[data-menu-overlay]');

  const lineSectionIds = new Set(lineSlugs);
  const navSectionMap = {
    inicio: 'inicio',
    grupo: 'grupo',
    lineas: 'lineas',
    oficio: 'oficio',
    contacto: 'contacto',
    hosting: 'lineas',
    series: 'lineas',
    atelier: 'lineas',
    voices: 'lineas',
  };

  const mainSections = ['inicio', 'grupo', 'lineas', 'oficio', 'contacto'];

  const getScrollOffset = () => {
    const raw = getComputedStyle(document.documentElement).getPropertyValue('--scroll-offset');
    const parsed = parseFloat(raw);
    return Number.isFinite(parsed) ? parsed : 96;
  };

  const resolveNavId = (sectionId) => navSectionMap[sectionId] ?? sectionId;

  const setActive = (sectionId) => {
    const navId = resolveNavId(sectionId);

    document.querySelectorAll('[data-nav-link]').forEach((link) => {
      const href = (link.hash || '').slice(1);
      const isLineLink = lineSectionIds.has(href);
      const isActive =
        href === sectionId || (href === navId && !isLineLink);

      link.classList.toggle('is-active', isActive);

      if (link.matches('.nav__link')) {
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    });
  };

  const updateActiveFromScroll = () => {
    const offset = getScrollOffset();
    let current = 'inicio';

    for (const id of mainSections) {
      const el = document.getElementById(id);
      if (!el) continue;
      if (el.getBoundingClientRect().top <= offset + 8) {
        current = id;
      }
    }

    if (current === 'lineas' || document.documentElement.classList.contains('is-lineas-active')) {
      setActive('lineas');
      return;
    }

    setActive(current);
  };

  const setScrolled = (scrolled) => {
    header?.setAttribute('data-scrolled', scrolled ? 'true' : 'false');
  };

  let scrollTicking = false;
  const onScroll = () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      setScrolled(window.scrollY > 20);
      updateActiveFromScroll();
      scrollTicking = false;
    });
  };

  setScrolled(window.scrollY > 20);
  updateActiveFromScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', updateActiveFromScroll, { passive: true });

  const getFocusable = (root) =>
    Array.from(
      root.querySelectorAll(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => !el.hasAttribute('hidden') && el.getClientRects().length > 0);

  let lastFocusedBeforeMenu = null;

  const closeMenu = () => {
    menuOverlay?.setAttribute('data-open', 'false');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
    document.body.classList.remove('menu-open');
    window.setTimeout(() => {
      menuOverlay?.setAttribute('hidden', '');
      lastFocusedBeforeMenu?.focus();
      lastFocusedBeforeMenu = null;
    }, 380);
  };

  const openMenu = () => {
    lastFocusedBeforeMenu = document.activeElement;
    menuOverlay?.removeAttribute('hidden');
    requestAnimationFrame(() => {
      menuOverlay?.setAttribute('data-open', 'true');
      const focusable = getFocusable(menuOverlay);
      focusable[0]?.focus();
    });
    menuToggle?.setAttribute('aria-expanded', 'true');
    menuToggle?.setAttribute('aria-label', 'Cerrar menú');
    document.body.classList.add('menu-open');
  };

  menuToggle?.addEventListener('click', () => {
    const open = menuOverlay?.hasAttribute('hidden');
    if (open) openMenu();
    else closeMenu();
  });

  menuClose?.addEventListener('click', closeMenu);

  menuOverlay?.addEventListener('click', (event) => {
    if (event.target === menuOverlay) closeMenu();
  });

  menuOverlay?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  menuOverlay?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !menuOverlay?.hasAttribute('data-open')) return;
    const focusable = getFocusable(menuOverlay);
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuOverlay?.getAttribute('data-open') === 'true') {
      closeMenu();
    }
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const scrollToSection = (target) => {
    target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
  };

  document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
    anchor.addEventListener('click', (event) => {
      // anchor.hash resolves the fragment regardless of whether href is
      // "#grupo" or "/#grupo" — needed since links must work from any page.
      const hash = anchor.hash;
      if (!hash || hash === '#') return;

      const sectionId = hash.slice(1);
      const isLine = lineSectionIds.has(sectionId);
      const target = isLine
        ? document.getElementById('lineas')
        : document.querySelector(hash);
      if (!target) return;

      event.preventDefault();

      // Menu overlay sets body.menu-open (overflow: hidden), which silently
      // blocks scrollIntoView — close it first so the scroll actually runs.
      if (menuOverlay?.getAttribute('data-open') === 'true') {
        closeMenu();
      }

      scrollToSection(target);

      if (isLine) {
        window.dispatchEvent(new CustomEvent('df:lineas-go', { detail: { slug: sectionId } }));
        setActive('lineas');
      } else if (navSectionMap[sectionId]) {
        setActive(sectionId);
      }

      history.pushState(null, '', hash);
    });
  });

  window.addEventListener('hashchange', () => {
    const id = window.location.hash.slice(1);
    if (id) setActive(id);
  });

  if (window.location.hash) {
    setActive(window.location.hash.slice(1));
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: var(--header-inset-y) var(--header-inset-x);
    pointer-events: none;
    transition: padding 320ms var(--ease-out);
  }

  .site-header[data-scrolled='true'] {
    padding-block: calc(var(--header-inset-y) * 0.72);
  }

  .site-header > * {
    pointer-events: auto;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-bar-min);
    padding: var(--header-bar-pad-y) 0.7rem var(--header-bar-pad-y) 1.15rem;
    max-width: var(--page-wide);
    margin-inline: auto;
    border-radius: var(--radius-pill);
    background: var(--header-bg);
    border: 1px solid var(--header-border);
    backdrop-filter: blur(var(--header-blur));
    -webkit-backdrop-filter: blur(var(--header-blur));
    box-shadow: var(--header-shadow);
    transition:
      background 360ms var(--ease-out),
      border-color 360ms var(--ease-out),
      box-shadow 360ms var(--ease-out),
      backdrop-filter 360ms var(--ease-out),
      -webkit-backdrop-filter 360ms var(--ease-out);
  }

  .site-header[data-scrolled='true'] .nav-bar {
    background: var(--header-bg-scrolled);
    border-color: var(--header-border-scrolled);
    box-shadow: var(--header-shadow-scrolled);
    backdrop-filter: blur(var(--header-blur-scrolled));
    -webkit-backdrop-filter: blur(var(--header-blur-scrolled));
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.2rem 0.45rem 0.2rem 0;
    border-radius: var(--radius-pill);
    transition: opacity 220ms var(--ease-out);
  }

  .brand:focus-visible {
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      opacity: 0.9;
    }

    .brand:hover .brand__mark {
      background: color-mix(in srgb, var(--bone) 9%, transparent);
    }
  }

  .brand__mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bone) 5%, transparent);
    transition: background 220ms var(--ease-out);
  }

  .brand__logo {
    width: 0.95rem;
    height: auto;
    color: var(--bone);
    filter: invert(1);
  }

  .brand__lockup {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--bone);
  }

  .brand__suffix {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .nav {
    display: none;
    align-items: center;
    gap: 0.1rem;
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--fog);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    min-height: 2.25rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    transition:
      color 220ms var(--ease-out),
      background 220ms var(--ease-out);
  }

  .nav__link::before {
    content: '';
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--ember-hot);
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover {
      color: var(--bone);
      background: color-mix(in srgb, var(--bone) 6%, transparent);
    }
  }

  .nav__link.is-active {
    color: var(--bone);
    background: color-mix(in srgb, var(--bone) 9%, transparent);
  }

  .nav__link.is-active::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav__link:focus-visible {
    outline-offset: 2px;
    background: color-mix(in srgb, var(--bone) 10%, transparent);
    color: var(--bone);
  }

  .nav__cta {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.85rem 0.35rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--ember-hot) 38%, transparent);
    background: color-mix(in srgb, var(--ember-hot) 10%, var(--void));
    color: var(--bone);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      background 240ms var(--ease-out),
      border-color 240ms var(--ease-out),
      color 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }

  .nav__cta-arrow {
    font-size: 0.95rem;
    line-height: 1;
    opacity: 0.72;
    transition:
      transform 240ms var(--ease-out),
      opacity 240ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__cta:hover {
      background: var(--bone);
      color: var(--void);
      border-color: var(--bone);
      box-shadow: 0 4px 20px color-mix(in srgb, var(--ember-hot) 22%, transparent);
    }

    .nav__cta:hover .nav__cta-arrow {
      transform: translateX(2px);
      opacity: 1;
    }
  }

  .nav__cta:focus-visible {
    outline-offset: 3px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ember-hot) 24%, transparent);
  }

  .nav__menu-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--bone);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
    transition: background 220ms var(--ease-out);
  }

  .nav__menu-btn:focus-visible {
    outline-offset: 3px;
    background: color-mix(in srgb, var(--bone) 8%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__menu-btn:hover {
      background: color-mix(in srgb, var(--bone) 6%, transparent);
    }
  }

  .nav__menu-btn:active {
    transform: scale(0.97);
  }

  .nav__menu-icon {
    position: relative;
    display: grid;
    gap: 0.35rem;
    width: 1.15rem;
  }

  .nav__menu-line {
    display: block;
    height: 1.5px;
    width: 100%;
    background: currentColor;
    border-radius: 1px;
    transition:
      transform 280ms var(--ease-out),
      opacity 200ms var(--ease-out);
    transform-origin: center;
  }

  .nav__menu-btn[aria-expanded='true'] .nav__menu-line:first-child {
    transform: translateY(0.43rem) rotate(45deg);
  }

  .nav__menu-btn[aria-expanded='true'] .nav__menu-line:last-child {
    transform: translateY(-0.43rem) rotate(-45deg);
  }

  .nav__menu-btn[aria-expanded='true'] .nav__menu-label {
    opacity: 0.72;
  }

  .nav__menu-icon--close .nav__menu-line:first-child {
    transform: translateY(0.43rem) rotate(45deg);
  }

  .nav__menu-icon--close .nav__menu-line:last-child {
    transform: translateY(-0.43rem) rotate(-45deg);
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: color-mix(in srgb, var(--void) 97%, transparent);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 4rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 380ms var(--ease-out),
      visibility 380ms var(--ease-out);
  }

  .menu-overlay[data-open='true'] {
    opacity: 1;
    visibility: visible;
  }

  .menu-overlay[hidden] {
    display: none;
  }

  .menu-overlay__close {
    position: absolute;
    top: calc(var(--header-inset-y) + 0.35rem);
    right: var(--header-inset-x);
    appearance: none;
    border: 0;
    background: color-mix(in srgb, var(--bone) 6%, transparent);
    color: var(--bone);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 200ms var(--ease-out);
  }

  .menu-overlay__close:focus-visible {
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .menu-overlay__close:hover {
      background: color-mix(in srgb, var(--bone) 12%, transparent);
    }
  }

  .menu-overlay__inner {
    width: min(38rem, 100%);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    transform: translateY(14px);
    opacity: 0;
    transition:
      transform 480ms var(--ease-out),
      opacity 480ms var(--ease-out);
  }

  .menu-overlay[data-open='true'] .menu-overlay__inner {
    transform: none;
    opacity: 1;
  }

  .menu-overlay__nav {
    display: grid;
    gap: 0.05rem;
  }

  .menu-overlay__nav > a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: color-mix(in srgb, var(--fog) 78%, var(--bone));
    padding-block: 0.35rem;
    transform: translateY(12px);
    opacity: 0;
    transition:
      color 220ms var(--ease-out),
      transform 440ms var(--ease-out),
      opacity 440ms var(--ease-out);
    transition-delay: calc(var(--menu-i, 0) * 40ms + 70ms);
  }

  .menu-overlay[data-open='true'] .menu-overlay__nav > a {
    transform: none;
    opacity: 1;
  }

  .menu-overlay__nav > a.is-active {
    color: var(--bone);
  }

  .menu-overlay__nav > a.is-active span::before {
    content: '';
    display: inline-block;
    width: 0.28em;
    height: 0.28em;
    margin-right: 0.28em;
    border-radius: 50%;
    background: var(--ember-hot);
    vertical-align: 0.14em;
  }

  @media (hover: hover) and (pointer: fine) {
    .menu-overlay__nav > a:hover {
      color: var(--bone);
    }
  }

  .menu-overlay__lines {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.5rem;
    padding-top: 1.35rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .menu-overlay__lines a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--mute);
    padding: 0.35rem 0;
    transform: translateY(8px);
    opacity: 0;
    transition:
      color 220ms var(--ease-out),
      transform 400ms var(--ease-out),
      opacity 400ms var(--ease-out);
    transition-delay: calc(var(--menu-i, 0) * 32ms + 160ms);
  }

  .menu-overlay[data-open='true'] .menu-overlay__lines a {
    transform: none;
    opacity: 1;
  }

  .menu-overlay__lines a.is-active {
    color: var(--bone);
  }

  .menu-overlay__lines a.is-active .menu-overlay__line-code::before {
    content: '';
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--ember-hot);
    vertical-align: 0.05em;
  }

  @media (hover: hover) and (pointer: fine) {
    .menu-overlay__lines a:hover {
      color: var(--fog);
    }
  }

  .menu-overlay__line-code {
    font-size: 0.98rem;
  }

  .menu-overlay__label {
    color: var(--mute);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .menu-overlay__email {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--bone);
    margin-bottom: 1.35rem;
    transition: opacity 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .menu-overlay__email:hover {
      opacity: 0.82;
    }
  }

  .menu-overlay__talk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3rem;

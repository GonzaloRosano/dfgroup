---
import { lines } from '../data/lines';

const navLinks = [
  { href: '#grupo', label: 'Grupo' },
  { href: '#lineas', label: 'Líneas' },
  { href: '#oficio', label: 'Oficio' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <div class="nav-bar">
    <a class="brand" href="#inicio" aria-label="Dark Feather Group — inicio">
      <img class="brand__logo" src="/logo.svg" alt="" width="22" height="24" />
      <span class="brand__name">Dark Feather</span>
    </a>

    <nav class="nav" aria-label="Principal">
      {navLinks.map((link) => (
        <a class="nav__link" href={link.href} data-nav-link>{link.label}</a>
      ))}
    </nav>

    <a class="nav__cta" href="#contacto">Empezar proyecto</a>

    <button
      class="nav__menu-btn"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-overlay"
      data-menu-toggle
    >
      Menú
    </button>
  </div>

  <div class="menu-overlay" id="menu-overlay" data-menu-overlay hidden>
    <div class="menu-overlay__inner">
      <nav class="menu-overlay__nav" aria-label="Menú completo">
        <a href="#inicio" data-menu-link>Inicio</a>
        {navLinks.map((link) => (
          <a href={link.href} data-menu-link>{link.label}</a>
        ))}
        {lines.map((line) => (
          <a href={`#${line.slug}`} data-menu-link>{line.code}</a>
        ))}
      </nav>

      <div class="menu-overlay__contact">
        <p class="menu-overlay__label">Consultas</p>
        <a class="menu-overlay__email" href="mailto:hola@darkfeathergroup.com">
          hola@darkfeathergroup.com
        </a>
        <p class="menu-overlay__phone">Tel. ejemplo · reemplazar</p>
        <a class="menu-overlay__talk" href="#contacto">Hablemos</a>
        <div class="menu-overlay__social">
          <span>Instagram · placeholder</span>
          <span>LinkedIn · placeholder</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const menuOverlay = document.querySelector('[data-menu-overlay]');

  const closeMenu = () => {
    menuOverlay?.setAttribute('hidden', '');
    menuToggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  };

  menuToggle?.addEventListener('click', () => {
    const open = menuOverlay?.hasAttribute('hidden');
    if (open) {
      menuOverlay?.removeAttribute('hidden');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('menu-open');
    } else {
      closeMenu();
    }
  });

  menuOverlay?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  const sections = ['inicio', 'grupo', 'lineas', 'oficio', 'contacto', 'hosting', 'series', 'atelier', 'voices'];
  const navLinks = document.querySelectorAll('[data-nav-link]');

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href')?.slice(1);
      link.classList.toggle('is-active', href === id);
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
  );

  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: 1.1rem 1.5rem;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--page-wide);
    margin-inline: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand__logo {
    width: 1.25rem;
    height: auto;
    filter: invert(1);
  }

  .brand__name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  .nav__link {
    color: var(--mute);
    font-size: 0.92rem;
    font-weight: 500;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--bone);
  }

  .nav__cta {
    display: none;
    font-size: 0.92rem;
    font-weight: 600;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 35%, transparent);
  }

  .nav__cta:hover {
    border-color: var(--bone);
  }

  .nav__menu-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--bone);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.35rem 0;
  }

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: color-mix(in srgb, var(--void) 96%, transparent);
    backdrop-filter: blur(18px);
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .menu-overlay[hidden] {
    display: none;
  }

  .menu-overlay__inner {
    width: min(36rem, 100%);
    display: grid;
    gap: 3.5rem;
  }

  .menu-overlay__nav {
    display: grid;
    gap: 0.35rem;
  }

  .menu-overlay__nav a {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--fog);
    transition: color 200ms var(--ease-out);
  }

  .menu-overlay__nav a:hover {
    color: var(--bone);
  }

  .menu-overlay__label {
    color: var(--mute);
    font-size: 0.82rem;
    margin-bottom: 0.65rem;
  }

  .menu-overlay__email {
    display: block;
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .menu-overlay__phone {
    color: var(--mute);
    font-size: 0.92rem;
    margin-bottom: 1.25rem;
  }

  .menu-overlay__talk {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 30%, transparent);
  }

  .menu-overlay__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    color: var(--mute);
    font-size: 0.88rem;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .nav,
    .nav__cta {
      display: flex;
    }

    .nav__menu-btn {
      display: none;
    }
  }
</style>

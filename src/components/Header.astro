---
import { lines } from '../data/lines';

const navLinks = [
  { href: '#inicio', label: 'Inicio' },
  { href: '#grupo', label: 'Grupo' },
  { href: '#lineas', label: 'Líneas' },
  { href: '#oficio', label: 'Oficio' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <div class="nav-bar">
    <a class="brand" href="#inicio" aria-label="Dark Feather Group — inicio">
      <img class="brand__logo" src="/logo.svg" alt="" width="22" height="24" />
      <span class="brand__name">DF Group</span>
    </a>

    <nav class="nav" aria-label="Principal">
      {
        navLinks.map((link) => (
          <a class="nav__link" href={link.href} data-nav-link>
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="btn btn--solid nav__cta" href="#contacto">Hablar</a>

    <button class="nav__burger" type="button" aria-label="Abrir menú" data-mobile-toggle>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-panel" data-mobile-panel hidden>
    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </div>
</header>

<script>
  const mobileToggle = document.querySelector('[data-mobile-toggle]');
  const mobilePanel = document.querySelector('[data-mobile-panel]');

  mobileToggle?.addEventListener('click', () => {
    const hidden = mobilePanel?.hasAttribute('hidden');
    if (hidden) mobilePanel?.removeAttribute('hidden');
    else mobilePanel?.setAttribute('hidden', '');
  });

  mobilePanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobilePanel?.setAttribute('hidden', '');
    });
  });

  const sections = ['inicio', 'grupo', 'lineas', 'oficio', 'contacto', 'hosting', 'series', 'atelier', 'voices'];
  const navLinks = document.querySelectorAll('[data-nav-link]');

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      const href = link.getAttribute('href')?.slice(1);
      link.classList.toggle('is-active', href === id);
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
  );

  sections.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    padding: 0.85rem 1.25rem;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--page-wide);
    margin-inline: auto;
    min-height: 3.25rem;
    padding: 0.45rem 0.85rem 0.45rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    background: color-mix(in srgb, var(--void) 82%, transparent);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .brand__logo {
    width: 1.35rem;
    height: auto;
    filter: invert(1);
  }

  .brand__name {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }

  .nav__link {
    color: var(--mute);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.45rem 0.65rem;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--bone);
  }

  .nav__cta {
    display: none;
    padding: 0.5rem 0.95rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav__burger span {
    display: block;
    height: 1.5px;
    width: 1.1rem;
    margin-inline: auto;
    background: var(--bone);
  }

  .mobile-panel {
    max-width: var(--page-wide);
    margin: 0.35rem auto 0;
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem;
    background: color-mix(in srgb, var(--void) 94%, transparent);
    border: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .mobile-panel[hidden] {
    display: none;
  }

  .mobile-panel a {
    padding: 0.7rem 0.75rem;
    color: var(--bone);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 960px) {
    .nav,
    .nav__cta {
      display: flex;
    }

    .nav__burger,
    .mobile-panel {
      display: none !important;
    }
  }
</style>

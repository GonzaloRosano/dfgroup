<div class="loader" data-loader aria-live="polite" aria-busy="true">
  <p class="loader__label">Cargando</p>
  <p class="loader__pct" data-loader-pct>0%</p>
  <div class="loader__track" aria-hidden="true">
    <div class="loader__fill" data-loader-fill></div>
  </div>
</div>

<script>
  const loader = document.querySelector('[data-loader]');
  const pctEl = document.querySelector('[data-loader-pct]');
  const fillEl = document.querySelector('[data-loader-fill]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const finish = () => {
    if (!loader) return;
    loader.classList.add('is-done');
    loader.setAttribute('aria-busy', 'false');
    document.documentElement.classList.add('is-loaded');
    window.dispatchEvent(new CustomEvent('df:loaded'));
    setTimeout(() => loader.remove(), reduceMotion ? 0 : 700);
  };

  if (reduceMotion || !loader || !pctEl || !fillEl) {
    if (pctEl) pctEl.textContent = '100%';
    if (fillEl) fillEl.style.transform = 'scaleX(1)';
    finish();
  } else {
    let progress = 0;
    const duration = 2200;
    const start = performance.now();

    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      progress = Math.round(eased * 100);
      pctEl.textContent = `${progress}%`;
      fillEl.style.transform = `scaleX(${eased})`;

      if (t < 1) {
        requestAnimationFrame(tick);
      } else {
        finish();
      }
    };

    requestAnimationFrame(tick);
  }
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    gap: 1rem;
    background: var(--void);
    text-align: center;
    transition: opacity 600ms var(--ease-out), visibility 600ms;
  }

  .loader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader__label {
    color: var(--mute);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin: 0 auto;
  }

  .loader__pct {
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin: 0 auto;
  }

  .loader__track {
    width: min(12rem, 40vw);
    height: 1px;
    margin: 0.5rem auto 0;
    background: color-mix(in srgb, var(--bone) 12%, transparent);
    overflow: hidden;
  }

  .loader__fill {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(0);
    background: linear-gradient(90deg, var(--ember-hot), var(--bone));
  }

  html:not(.is-loaded) body {
    overflow: hidden;
  }
</style>

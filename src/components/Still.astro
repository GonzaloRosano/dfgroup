---
import type { Still as StillData } from '../data/stills';

type Variant = 'band' | 'inline' | 'modest';

interface Props {
  still: StillData;
  variant?: Variant;
}

const { still, variant = 'band' } = Astro.props;
---

<figure class:list={['still', `still--${variant}`]}>
  <img
    src={still.src}
    alt={still.alt}
    width="1920"
    height="1080"
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <a href="/derechos">{still.caption}</a>
  </figcaption>
</figure>

<style>
  .still {
    margin: 0;
  }

  .still img {
    width: 100%;
    object-fit: cover;
    object-position: center;
    background: var(--asphalt);
  }

  figcaption {
    margin-top: 0.55rem;
    color: var(--mute);
    font-size: 0.78rem;
  }

  figcaption a {
    color: var(--mute);
  }

  figcaption a:hover {
    color: var(--fog);
  }

  /* Thin accent strip — typography leads, image whispers */
  .still--band {
    padding: 0 0 var(--space-md);
  }

  .still--band img {
    height: clamp(5rem, 14vw, 7.5rem);
    opacity: 0.82;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  /* Beside copy in a product grid */
  .still--inline {
    max-width: 16rem;
  }

  .still--inline img {
    height: clamp(7rem, 18vw, 10rem);
    border-radius: 0.35rem;
    opacity: 0.78;
  }

  /* Modest block for /grupo — not cinematic */
  .still--modest {
    padding: 0 0 var(--space-md);
  }

  .still--modest img {
    max-width: 28rem;
    height: clamp(8rem, 22vw, 11rem);
    opacity: 0.85;
    border-radius: 0.25rem;
  }
</style>

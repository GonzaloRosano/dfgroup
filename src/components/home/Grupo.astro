---
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang).grupo;
---

<section id="grupo" class="section about" tabindex="0" role="region" aria-label={t.eyebrow}>
  <div class="tagline-strip reveal" data-reveal aria-hidden="true">
    <p>{t.tagline}</p>
  </div>
  <div class="container about__inner">
    <p class="section-eyebrow reveal reveal--left" data-reveal>{t.eyebrow}</p>
    <h2 class="about__title reveal" data-reveal>{t.title}</h2>
    <div class="about__body" data-reveal-group>
      {t.body.map((paragraph) => (
        <p class="reveal" data-reveal>{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: var(--home-section-min-h);
    height: var(--home-section-min-h);
    padding-block: 0;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .about__inner {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    /* When content is taller than the available space, plain `center`
       overflows both ways — pushing the top past the tagline strip above
       it. `safe center` falls back to start-alignment instead. */
    justify-content: center;
    justify-content: safe center;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }

  .tagline-strip {
    position: relative;
    z-index: 1;
    border-block: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding: 1.1rem 0;
    overflow: hidden;
  }

  .tagline-strip p {
    max-width: none;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--fog);
    text-transform: uppercase;
  }

  .about__title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: var(--space-md);
    max-width: 16ch;
  }

  .about__body {
    display: grid;
    gap: 1.35rem;
  }

  .about__body p {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.15rem);
    line-height: 1.75;
    max-width: 58ch;
  }

  /* Short viewports (landscape phones, small browser windows): a forced
     100dvh section clips real content there — fall back to natural height
     and plain scroll instead of fighting the layout to fit one screen. */
  @media (max-height: 500px) {
    .about {
      height: auto;
      min-height: 100vh;
      overflow: visible;
    }
  }

  @media (max-width: 959px) {
    .about {
      min-height: var(--home-section-min-h);
      height: var(--home-section-min-h);
      padding-bottom: min(18vh, 160px);
      /* Content length varies section to section — when it doesn't fit,
         scroll inside the section instead of a fixed overflow:hidden
         silently hiding whatever ran past the fold. */
      overflow-y: auto;
    }
  }

  @media (min-width: 960px) {
    .about__inner.container {
      width: var(--home-content-max);
      max-width: calc(50vw - 0.5rem);
      margin-inline: unset;
      margin-left: var(--home-content-inset);
      margin-right: auto;
      padding-right: 1.5rem;
      box-sizing: border-box;
    }

    .tagline-strip p {
      text-align: left;
      width: var(--home-content-max);
      max-width: calc(50vw - 0.5rem);
      margin-inline: unset;
      margin-left: var(--home-content-inset);
      padding-right: 1.5rem;
      box-sizing: border-box;
    }
  }
</style>

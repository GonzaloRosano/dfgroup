---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dark Feather Group',
  description = 'Colectivo creativo noir: DF Hosting, DF Series, DF Atelier, DF Voices.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: Single-page noir studio — scroll storytelling with DF atmosphere, not a brochure dump.
      OWN-WORLD: Pure black ground, bone CTAs as pills, floating nav pill, fog copy, ember only as quiet core in WebGL.
      STORY: Land → grupo → líneas → oficio → contacto, all on one scroll.
      FIRST VIEWPORT: Editorial headline, supporting line, pill CTAs, Three.js film still.
      FORM: Neoconda structure × Trionn typography, adapted to Dark Feather noir.
    -->
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

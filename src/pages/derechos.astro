---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteAssets } from '../data/assets';
---

<BaseLayout
  title="Derechos e imágenes · Dark Feather Group"
  description="Origen y licencia de los activos del sitio Dark Feather Group."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Derechos e imágenes</h1>
      <p class="page-hero__lead">
        Este sitio no usa fotografías de archivo. La atmósfera es tipográfica,
        CSS y WebGL procedural.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container rights">
      <h2>Activos del sitio</h2>
      <ul class="rights-list">
        {
          siteAssets.map((asset) => (
            <li>
              {asset.path ? (
                <img src={asset.path} alt={asset.description} width="120" height="120" loading="lazy" />
              ) : (
                <div class="rights-procedural" aria-hidden="true" />
              )}
              <div>
                <p class="rights-list__file">{asset.label}</p>
                <p>{asset.description}</p>
                <p>
                  En <a href={asset.usedOn}>{asset.usedOn}</a>
                </p>
                {asset.license && (
                  <p>
                    Licencia{' '}
                    <a href={asset.licenseUrl}>{asset.license}</a>
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container rights">
      <h2>Tipografía</h2>
      <p>
        Bricolage Grotesque e IBM Plex Sans se cargan desde Google Fonts con
        licencia abierta (SIL Open Font License).
      </p>
      <p>
        <a href="https://fonts.google.com/specimen/Bricolage+Grotesque">Bricolage Grotesque</a>
        {' · '}
        <a href="https://fonts.google.com/specimen/IBM+Plex+Sans">IBM Plex Sans</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .rights h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .rights > p {
    color: var(--fog);
    margin-bottom: 1.75rem;
  }

  .rights-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rights-list li {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
    color: var(--fog);
  }

  .rights-list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .rights-list img {
    width: 5rem;
    height: auto;
    filter: invert(1);
  }

  .rights-procedural {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-soft);
    border: 1px solid color-mix(in srgb, var(--ember-hot) 40%, transparent);
    background:
      linear-gradient(var(--bone) 1px, transparent 1px),
      linear-gradient(90deg, var(--bone) 1px, transparent 1px);
    background-size: 0.75rem 0.75rem;
    background-color: var(--asphalt);
    opacity: 0.5;
  }

  .rights-list__file {
    color: var(--bone);
    margin-bottom: 0.35rem;
    word-break: break-all;
  }

  .rights-list a {
    color: var(--bone);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>

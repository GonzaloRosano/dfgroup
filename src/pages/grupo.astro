---
import BaseLayout from '../layouts/BaseLayout.astro';
import Still from '../components/Still.astro';
import { lines } from '../data/lines';
import { stillForPath } from '../data/stills';

const still = stillForPath('/grupo');
---

<BaseLayout
  title="El grupo · Dark Feather Group"
  description="Quiénes somos: colectivo creativo Dark Feather Group."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">El colectivo detrás de la pluma.</h1>
      <p class="page-hero__lead">
        Diseñamos, desarrollamos, producimos arte y sonido. Trabajamos a
        contraluz: menos ruido, más atmósfera y oficio.
      </p>
      <div class="btn-row">
        <a class="btn btn--solid" href="/contacto">Contactar</a>
        <a class="btn btn--ghost" href="/atelier">Ir a DF Atelier</a>
      </div>
    </div>
  </section>

  {still && <Still still={still} variant="modest" />}

  <section class="section">
    <div class="container crafts">
      <article>
        <h2>Diseño</h2>
        <p>Identidad, interfaces y sistemas con jerarquía cinematográfica.</p>
      </article>
      <article>
        <h2>Desarrollo</h2>
        <p>Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.</p>
      </article>
      <article>
        <h2>Arte</h2>
        <p>Dirección de arte y motion que sostienen el mundo de la marca.</p>
      </article>
      <article>
        <h2>Producción</h2>
        <p>De concepto a entrega, con ritmo de estudio.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">Líneas del grupo</h2>
      <ul class="group-lines">
        {
          lines.map((line) => (
            <li>
              <a href={`/${line.slug}`}>
                <strong>{line.code}</strong>
                <span>{line.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .crafts {
    display: grid;
    gap: 2rem;
  }

  .crafts h2 {
    font-size: 2rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .crafts p {
    color: var(--fog);
  }

  .group-lines {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .group-lines a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .group-lines strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .group-lines span {
    color: var(--fog);
  }

  @media (min-width: 800px) {
    .crafts {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Atmosphere from '../components/Atmosphere';
import ScrollProgress from '../components/ScrollProgress.astro';
import { lines } from '../data/lines';

const lineVisuals: Record<string, string> = {
  hosting: 'grid-hosting',
  series: 'grid-series',
  atelier: 'grid-atelier',
  voices: 'grid-voices',
};

const crafts = [
  {
    title: 'Diseño',
    copy: 'Identidad, interfaces y sistemas con jerarquía cinematográfica.',
  },
  {
    title: 'Desarrollo',
    copy: 'Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.',
  },
  {
    title: 'Arte',
    copy: 'Dirección de arte y motion que sostienen el mundo de la marca.',
  },
  {
    title: 'Producción',
    copy: 'De concepto a entrega, con ritmo de estudio.',
  },
];
---

<BaseLayout title="Dark Feather Group">
  <ScrollProgress />

  <div class="home-atmosphere" aria-hidden="true">
    <Atmosphere client:load />
  </div>

  <section id="inicio" class="home-hero">
    <div class="container home-hero__grid">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">Colectivo creativo noir</p>
        <h1 class="home-hero__title">Diseñado para significar algo.</h1>
        <p class="home-hero__lead">
          Dark Feather Group une diseño, desarrollo, arte y producción bajo una
          sola atmósfera. Cuatro líneas. Un mismo oficio a contraluz.
        </p>
        <div class="btn-row">
          <a class="btn btn--solid" href="#contacto">Empezar conversación</a>
          <a class="btn btn--ghost" href="#grupo">Conocer el grupo</a>
        </div>
      </div>
      <div class="home-hero__mark" aria-hidden="true">
        <img src="/logo.svg" alt="" width="120" height="133" />
      </div>
    </div>
  </section>

  <section id="grupo" class="section about">
    <div class="container about__grid">
      <div class="about__intro">
        <h2 class="section__title section__title--left">
          El colectivo detrás de la pluma.
        </h2>
        <p class="section__lead section__lead--left">
          Diseñamos, desarrollamos, producimos arte y sonido. Trabajamos a
          contraluz: menos ruido, más atmósfera y oficio.
        </p>
      </div>
      <div class="about__stat">
        <p class="about__stat-num">4</p>
        <p class="about__stat-label">Líneas de producto bajo una misma dirección de arte.</p>
      </div>
    </div>
  </section>

  <section id="lineas" class="section products" aria-label="Líneas del grupo">
    <div class="container">
      <h2 class="section__title">Cuatro líneas. Una atmósfera.</h2>
      <p class="section__lead">
        Cada código DF resuelve un frente distinto del universo creativo, sin
        perder la pluma ni el tono noir del grupo.
      </p>

      <div class="products__grid">
        {
          lines.map((line) => (
            <article class="product-card" id={line.slug} data-reveal>
              <div class:list={['product-card__visual', lineVisuals[line.slug]]} aria-hidden="true" />
              <div class="product-card__body">
                <h3 class="product-card__code">{line.code}</h3>
                <p class="product-card__tagline">{line.tagline}</p>
                <p class="product-card__summary">{line.summary}</p>
                <ul class="product-card__points">
                  {line.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <a class="product-card__link" href={`#${line.slug}`}>
                  Explorar {line.code}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="oficio" class="section craft">
    <div class="container">
      <h2 class="section__title">Oficio con atmósfera.</h2>
      <p class="section__lead">
        No vendemos plantillas. Construimos mundos visuales, técnicos y
        sonoros que se sostienen solos.
      </p>

      <div class="craft__grid">
        {
          crafts.map((item) => (
            <article class="craft__item" data-reveal>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section contact">
    <div class="container contact__inner">
      <h2 class="section__title">En la sombra, a un mensaje.</h2>
      <p class="section__lead">
        Contanos qué línea te interesa y cómo suena el proyecto. Respondemos con
        foco, no con un formulario vacío de promesas.
      </p>
      <div class="btn-row contact__cta">
        <a class="btn btn--solid" href="mailto:hola@darkfeathergroup.com">
          hola@darkfeathergroup.com
        </a>
      </div>
      <p class="contact__hint">
        Correo de ejemplo. Reemplazá con el canal real del grupo.
      </p>

      <ul class="contact__lines">
        {
          lines.map((line) => (
            <li>
              <a href={`#${line.slug}`}>
                <span>{line.code}</span>
                <span>{line.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('is-visible');
    });
  }
</script>

<style>
  .home-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .home-atmosphere :global(.atmosphere),
  .home-atmosphere :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 42% at 16% 36%, rgba(0, 0, 0, 0.62) 0%, transparent 72%),
      radial-gradient(ellipse 100% 90% at 50% 50%, transparent 38%, rgba(0, 0, 0, 0.58) 100%);
    pointer-events: none;
  }

  .section__title--left,
  .section__lead--left {
    text-align: left;
    margin-inline: 0;
  }

  .home-hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
  }

  .home-hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .home-hero__content {
    animation: rise 900ms var(--ease-out) both;
  }

  .home-hero__eyebrow {
    color: var(--mute);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .home-hero__title {
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    max-width: 12ch;
    margin-bottom: 1.25rem;
  }

  .home-hero__lead {
    color: var(--fog);
    margin-bottom: 1.85rem;
    font-size: 1.12rem;
    max-width: 42ch;
  }

  .home-hero__mark {
    justify-self: center;
    opacity: 0.12;
  }

  .home-hero__mark img {
    width: clamp(5rem, 18vw, 9rem);
    height: auto;
    filter: invert(1);
  }

  .about {
    position: relative;
    z-index: 1;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .about__grid {
    display: grid;
    gap: 3rem;
    align-items: end;
  }

  .about__stat {
    padding: 1.75rem;
    border-radius: var(--radius-soft);
    border: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
    background: color-mix(in srgb, var(--panel) 80%, transparent);
  }

  .about__stat-num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 7rem);
    line-height: 0.85;
    margin-bottom: 0.5rem;
  }

  .about__stat-label {
    color: var(--fog);
    max-width: 22ch;
  }

  .products {
    position: relative;
    z-index: 1;
  }

  .products__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--space-lg);
  }

  .product-card {
    display: grid;
    gap: 0;
    border-radius: var(--radius-soft);
    border: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  .product-card.is-visible {
    opacity: 1;
    transform: none;
  }

  .product-card:hover {
    border-color: color-mix(in srgb, var(--bone) 22%, transparent);
  }

  .product-card__visual {
    min-height: 5.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .grid-hosting {
    background:
      linear-gradient(var(--bone) 1px, transparent 1px),
      linear-gradient(90deg, var(--bone) 1px, transparent 1px);
    background-size: 1.25rem 1.25rem;
    background-color: var(--asphalt);
    opacity: 0.35;
  }

  .grid-series {
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 0.65rem,
      color-mix(in srgb, var(--ember-hot) 35%, transparent) 0.65rem,
      color-mix(in srgb, var(--ember-hot) 35%, transparent) 0.7rem
    );
    background-color: var(--asphalt);
    opacity: 0.5;
  }

  .grid-atelier {
    background:
      radial-gradient(circle at 30% 40%, color-mix(in srgb, var(--ember) 25%, transparent), transparent 55%),
      radial-gradient(circle at 70% 60%, color-mix(in srgb, var(--bone) 8%, transparent), transparent 50%);
    background-color: var(--asphalt);
  }

  .grid-voices {
    background: repeating-linear-gradient(
      -12deg,
      transparent,
      transparent 0.4rem,
      color-mix(in srgb, var(--bone) 12%, transparent) 0.4rem,
      color-mix(in srgb, var(--bone) 12%, transparent) 0.45rem
    );
    background-color: var(--asphalt);
    opacity: 0.45;
  }

  .product-card__body {
    padding: 1.75rem;
  }

  .product-card__code {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .product-card__tagline {
    color: var(--ember-hot);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .product-card__summary {
    color: var(--fog);
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }

  .product-card__points {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .product-card__points li {
    color: var(--mute);
    font-size: 0.92rem;
    padding-left: 1rem;
    position: relative;
  }

  .product-card__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--ember);
  }

  .product-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--bone);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .craft {
    position: relative;
    z-index: 1;
    padding-block: var(--space-2xl);
  }

  .craft__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--space-lg);
  }

  .craft__item {
    padding: 1.75rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 550ms var(--ease-out),
      transform 550ms var(--ease-out);
  }

  .craft__item.is-visible {
    opacity: 1;
    transform: none;
  }

  .craft__item h3 {
    font-size: 1.85rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .craft__item p {
    color: var(--fog);
  }

  .contact {
    position: relative;
    z-index: 1;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .contact__inner {
    text-align: center;
  }

  .contact__cta {
    justify-content: center;
  }

  .contact__hint {
    margin-top: 1rem;
    color: var(--mute);
    font-size: 0.9rem;
    margin-inline: auto;
  }

  .contact__lines {
    list-style: none;
    margin: var(--space-lg) auto 0;
    padding: 0;
    max-width: 40rem;
    display: grid;
    gap: 0.75rem;
  }

  .contact__lines a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-soft);
    border: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
    background: color-mix(in srgb, var(--panel) 80%, transparent);
    text-align: left;
  }

  .contact__lines a:hover {
    border-color: color-mix(in srgb, var(--bone) 28%, transparent);
  }

  .contact__lines a span:first-child {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
  }

  .contact__lines a span:last-child {
    color: var(--fog);
    font-size: 0.95rem;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (min-width: 720px) {
    .home-hero__grid {
      grid-template-columns: 1.15fr 0.35fr;
    }

    .home-hero__mark {
      justify-self: end;
    }

    .about__grid {
      grid-template-columns: 1.4fr 0.6fr;
    }

    .craft__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 3rem;
    }
  }

  @media (min-width: 960px) {
    .products__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__content {
      animation: none;
    }

    .product-card,
    .craft__item {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import Atmosphere from '../components/Atmosphere';
import ScrollProgress from '../components/ScrollProgress.astro';
import { lines } from '../data/lines';

const crafts = [
  {
    title: 'Diseño',
    copy: 'Identidad, interfaces y sistemas con jerarquía cinematográfica.',
  },
  {
    title: 'Desarrollo',
    copy: 'Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.',
  },
  {
    title: 'Arte',
    copy: 'Dirección de arte y motion que sostienen el mundo de la marca.',
  },
  {
    title: 'Producción',
    copy: 'De concepto a entrega, con ritmo de estudio.',
  },
];

const lineIcons: Record<string, string> = {
  hosting: 'M4 18h16M6 14h12M8 10h8M10 6h4',
  series: 'M4 6h4v12H4zm6 0h4v12h-4zm6 0h4v12h-4z',
  atelier: 'M12 3L5 20h14L12 3zm0 6l2.5 7h-5L12 9z',
  voices: 'M4 12c2-4 6-6 8-6s6 2 8 6M6 14c1.5 3 4 5 6 5s4.5-2 6-5',
};
---

<BaseLayout title="Dark Feather Group">
  <LoadingScreen />
  <ScrollProgress />

  <div class="home-atmosphere" aria-hidden="true">
    <Atmosphere client:load />
  </div>

  <section id="inicio" class="neo-hero">
    <div class="container neo-hero__inner">
      <h1 class="neo-hero__title">Dark Feather Group</h1>
      <p class="neo-hero__tagline">
        La atmósfera creativa noir llegó al estudio. Cuatro líneas, un mismo oficio.
      </p>
      <a class="btn btn--solid neo-hero__cta" href="#grupo">Explorar DF Group</a>
    </div>
  </section>

  <div class="neo-metric" aria-hidden="true">
    <span class="neo-metric__num">04</span>
    <span class="neo-metric__label">Líneas de producto</span>
  </div>

  <section id="grupo" class="section neo-about">
    <div class="container">
      <p class="neo-label">Sobre el grupo</p>
      <h2 class="neo-title">El colectivo detrás de la pluma.</h2>
      <p class="neo-lead">
        Diseñamos, desarrollamos, producimos arte y sonido. Trabajamos a
        contraluz: menos ruido, más atmósfera y oficio bajo una sola dirección de arte.
      </p>
    </div>
  </section>

  <section id="lineas" class="section neo-features" aria-label="Líneas del grupo">
    <div class="container">
      <p class="neo-label">Líneas</p>
      <h2 class="neo-title">Cuatro frentes bajo una pluma.</h2>
      <p class="neo-lead neo-lead--center">
        Cada código DF resuelve un frente distinto del universo creativo.
      </p>

      <div class="neo-features__grid">
        {
          lines.map((line, i) => (
            <article class="neo-feature" id={line.slug} data-reveal>
              <div class="neo-feature__head">
                <span class="neo-feature__num">{String(i + 1).padStart(2, '0')}</span>
                <svg class="neo-feature__icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={lineIcons[line.slug]} fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </div>
              <h3 class="neo-feature__title">{line.code}</h3>
              <p class="neo-feature__tag">{line.tagline}</p>
              <p class="neo-feature__copy">{line.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section neo-specs">
    <div class="container">
      <p class="neo-label">Especificaciones</p>
      <h2 class="neo-title">Lo que incluye cada línea.</h2>

      <div class="neo-specs__list">
        {
          lines.map((line) => (
            <article class="neo-spec" id={`spec-${line.slug}`}>
              <h3>{line.code}</h3>
              <ul>
                {line.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="oficio" class="section neo-features neo-features--craft">
    <div class="container">
      <p class="neo-label">Oficio</p>
      <h2 class="neo-title">Oficio con atmósfera.</h2>

      <div class="neo-features__grid">
        {
          crafts.map((item, i) => (
            <article class="neo-feature" data-reveal>
              <div class="neo-feature__head">
                <span class="neo-feature__num">{String(i + 5).padStart(2, '0')}</span>
              </div>
              <h3 class="neo-feature__title">{item.title}</h3>
              <p class="neo-feature__copy">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section neo-waitlist">
    <div class="container neo-waitlist__inner">
      <p class="neo-label">Contacto</p>
      <h2 class="neo-title">Hablar con el grupo</h2>
      <p class="neo-lead neo-lead--center">
        Contanos qué línea te interesa y cómo suena el proyecto.
      </p>
      <a class="btn btn--solid" href="mailto:hola@darkfeathergroup.com">
        hola@darkfeathergroup.com
      </a>
      <p class="neo-waitlist__hint">Correo de ejemplo. Reemplazá con el canal real del grupo.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('is-visible');
    });
  }
</script>

<style>
  .home-atmosphere {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .home-atmosphere :global(.atmosphere),
  .home-atmosphere :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 48% 42% at 78% 40%, transparent 0%, rgba(0, 0, 0, 0.5) 70%),
      radial-gradient(ellipse 100% 85% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.55) 100%);
    pointer-events: none;
  }

  .neo-hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
  }

  .neo-hero__inner {
    max-width: 18ch;
  }

  .neo-hero__title {
    font-size: clamp(3.2rem, 11vw, 7.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .neo-hero__tagline {
    color: var(--fog);
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    max-width: 38ch;
    margin-bottom: 2rem;
    line-height: 1.65;
  }

  .neo-hero__cta {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }

  .neo-metric {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    width: var(--page-wide);
    max-width: calc(100% - 2.5rem);
    margin: -2rem auto 0;
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .neo-metric__num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
  }

  .neo-metric__label {
    color: var(--mute);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .neo-about,
  .neo-features,
  .neo-specs,
  .neo-waitlist {
    position: relative;
    z-index: 1;
  }

  .neo-lead--center {
    margin-inline: auto;
    text-align: center;
  }

  .neo-features__grid {
    display: grid;
    gap: 0;
    margin-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .neo-feature {
    padding: 2.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 550ms var(--ease-out),
      transform 550ms var(--ease-out);
  }

  .neo-feature.is-visible {
    opacity: 1;
    transform: none;
  }

  .neo-feature__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .neo-feature__num {
    color: var(--mute);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .neo-feature__icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--ember-hot);
  }

  .neo-feature__title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .neo-feature__tag {
    color: var(--ember-hot);
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .neo-feature__copy {
    color: var(--fog);
    max-width: 48ch;
  }

  .neo-specs__list {
    display: grid;
    gap: 0;
    margin-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .neo-spec {
    padding: 1.75rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .neo-spec h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .neo-spec ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .neo-spec li {
    color: var(--fog);
    padding-left: 1rem;
    position: relative;
    font-size: 0.95rem;
  }

  .neo-spec li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--ember);
  }

  .neo-waitlist__inner {
    text-align: center;
  }

  .neo-waitlist__hint {
    margin-top: 1rem;
    color: var(--mute);
    font-size: 0.9rem;
  }

  @media (min-width: 960px) {
    .neo-features__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }

    .neo-feature:nth-child(odd) {
      padding-right: 2rem;
    }

    .neo-specs__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .neo-feature {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Atmosphere from '../components/Atmosphere';
import ScrollProgress from '../components/ScrollProgress.astro';
import { lines } from '../data/lines';

const crafts = [
  {
    title: 'Diseño',
    copy: 'Identidad, interfaces y sistemas con jerarquía cinematográfica.',
  },
  {
    title: 'Desarrollo',
    copy: 'Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.',
  },
  {
    title: 'Arte',
    copy: 'Dirección de arte y motion que sostienen el mundo de la marca.',
  },
  {
    title: 'Producción',
    copy: 'De concepto a entrega, con ritmo de estudio.',
  },
];

---

<BaseLayout title="Dark Feather Group">
  <ScrollProgress />

  <div class="home-atmosphere" aria-hidden="true">
    <Atmosphere client:load />
  </div>

  <section id="inicio" class="hero">
    <div class="hero__shield" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy hero-enter">
        <p class="hero__eyebrow hero-enter__item" style="--enter-i: 0">Dark Feather Group</p>
        <h1 class="hero__title">
          <span class="hero-enter__item" style="--enter-i: 1">Diseñado para</span>
          <span class="hero-enter__item" style="--enter-i: 2">significar algo.</span>
        </h1>
        <p class="hero__lead hero-enter__item" style="--enter-i: 3">
          Cuatro líneas, un mismo oficio. Estudio creativo noir — hosting, series,
          taller y voces bajo una sola pluma.
        </p>
        <div class="hero__actions hero-enter__item" style="--enter-i: 4">
          <a class="btn btn--solid" href="#contacto">Empezar proyecto</a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true"></div>
    </div>
  </section>

  <section id="grupo" class="section about" tabindex="0" role="region" aria-label="Grupo">
    <div class="tagline-strip reveal" data-reveal aria-hidden="true">
      <p>Sombra·Oficio·Presencia</p>
    </div>
    <div class="container about__inner">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Grupo</p>
      <h2 class="about__title reveal" data-reveal>El colectivo detrás de la pluma.</h2>
      <div class="about__body" data-reveal-group>
        <p class="reveal" data-reveal>
          Trabajamos a contraluz: menos ruido, más atmósfera. Identidad,
          desarrollo web, arte y sonido — bajo una sola dirección, no como
          cuatro proveedores sueltos con el mismo logo.
        </p>
        <p class="reveal" data-reveal>
          No somos una fábrica de plantillas ni un pitch deck con métricas
          infladas. Somos cuatro líneas — hosting, series, taller y voces —
          con el mismo idioma visual y el mismo criterio editorial.
        </p>
        <p class="reveal" data-reveal>
          Un proyecto de Dark Feather se nota antes de leer el nombre: una
          marca que parece habitada, una serie que respira en capítulos, un
          sitio que no huele a plantilla. Ese es el oficio completo.
        </p>
      </div>
    </div>
  </section>

  <section
    id="lineas"
    class="lines-showcase"
    data-lines-showcase
    data-lines-index="0"
    aria-label="Líneas del grupo"
  >
    <div class="lines-showcase__stage">
      <header class="lines-showcase__header container">
        <p class="section-eyebrow">Líneas</p>
        <p class="lines-showcase__counter" data-lines-counter aria-live="polite">01 — DF Hosting</p>
      </header>

      <div class="lines-showcase__viewport" data-lines-viewport>
        <div class="lines-showcase__track" data-lines-track>
          {
            lines.map((line, i) => (
              <article
                class:list={['lines-showcase__panel', i === 0 && 'is-active']}
                id={line.slug}
                data-panel={i}
                aria-label={line.code}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <div class="lines-showcase__copy container">
                  <span class="lines-showcase__index">{String(i + 1).padStart(2, '0')}</span>
                  <h2 class="lines-showcase__code">{line.code}</h2>
                  <p class="lines-showcase__tag">{line.tagline}</p>
                  <p class="lines-showcase__summary">{line.summary}</p>
                  <ul class="lines-showcase__points">
                    {line.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="lines-showcase__controls container">
        <button type="button" class="lines-showcase__arrow" data-lines-prev aria-label="Anterior">
          <span aria-hidden="true">←</span>
        </button>
        <div class="lines-showcase__progress" role="tablist" aria-label="Líneas del grupo">
          {
            lines.map((line, i) => (
              <button
                type="button"
                role="tab"
                class:list={['lines-showcase__dot', i === 0 && 'is-active']}
                data-lines-dot={i}
                aria-label={`Ir a ${line.code}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <button type="button" class="lines-showcase__arrow" data-lines-next aria-label="Siguiente">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </section>

  <section id="oficio" class="section crafts" tabindex="0" role="region" aria-label="Oficio">
    <div class="container">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Oficio</p>
      <h2 class="crafts__title reveal" data-reveal>Oficio con atmósfera.</h2>
      <p class="crafts__lead reveal" data-reveal>
        Lo que hacemos cuando la pluma baja al papel — o al código.
      </p>

      <div class="crafts__grid" data-reveal-group>
        {
          crafts.map((item) => (
            <article class="craft-card card-interactive reveal" data-reveal>
              <h3 class="craft-card__title">{item.title}</h3>
              <p class="craft-card__copy">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section contact" tabindex="0" role="region" aria-label="Contacto">
    <div class="container contact__inner" data-reveal-group>
      <p class="section-eyebrow reveal reveal--left" data-reveal>Contacto</p>
      <h2 class="contact__title reveal" data-reveal>Hablemos.</h2>
      <p class="contact__lead reveal" data-reveal>
        Contanos qué línea te interesa y cómo suena el proyecto. Respondemos con
        criterio, no con un bot.
      </p>
      <a class="btn btn--solid contact__cta reveal" data-reveal href="mailto:darkfeathergroup@gmail.com">
        darkfeathergroup@gmail.com
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('[data-reveal-group]').forEach((group) => {
    group.querySelectorAll('[data-reveal]').forEach((el, i) => {
      (el as HTMLElement).style.setProperty('--reveal-delay', `${i * 120}ms`);
    });
  });

  if (!reduceMotion) {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');

    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35, rootMargin: '0px 0px -8% 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('is-visible');
    });
  }

  const linesShowcase = document.querySelector('[data-lines-showcase]') as HTMLElement | null;
  const linesViewport = document.querySelector('[data-lines-viewport]') as HTMLElement | null;
  const linesCounter = document.querySelector('[data-lines-counter]');
  const linesDots = document.querySelectorAll('[data-lines-dot]');
  const linesPanels = document.querySelectorAll('.lines-showcase__panel');
  const lineLabels = ['DF Hosting', 'DF Series', 'DF Atelier', 'DF Voices'];
  const lineSlugs = ['hosting', 'series', 'atelier', 'voices'];
  const PANEL_COUNT = linesPanels.length || 4;

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  let currentIndex = 0;

  const lineasInView = () => {
    if (!linesShowcase) return false;
    const rect = linesShowcase.getBoundingClientRect();
    return rect.top < window.innerHeight * 0.62 && rect.bottom > window.innerHeight * 0.28;
  };

  const setLineasSlide = (nextIndex: number, announce = true) => {
    if (!linesShowcase) return;

    const index = clamp(((nextIndex % PANEL_COUNT) + PANEL_COUNT) % PANEL_COUNT, 0, PANEL_COUNT - 1);
    currentIndex = index;
    linesShowcase.dataset.linesIndex = String(index);
    linesShowcase.style.setProperty('--lines-index', String(index));

    if (linesCounter) {
      linesCounter.textContent = `${String(index + 1).padStart(2, '0')} — ${lineLabels[index]}`;
    }

    linesDots.forEach((dot, i) => {
      const active = i === index;
      dot.classList.toggle('is-active', active);
      dot.setAttribute('aria-selected', active ? 'true' : 'false');
    });

    linesPanels.forEach((panel, i) => {
      const active = i === index;
      panel.classList.toggle('is-active', active);
      panel.setAttribute('aria-hidden', active ? 'false' : 'true');
    });

    document.documentElement.classList.toggle('is-lineas-active', lineasInView());

    if (announce) {
      window.dispatchEvent(
        new CustomEvent('df:lineas-panel', {
          detail: { index, frac: 0, progress: index, raw: index / Math.max(PANEL_COUNT - 1, 1), settled: true },
        }),
      );
    }
  };

  const goLineas = (delta: number) => setLineasSlide(currentIndex + delta);

  document.querySelector('[data-lines-prev]')?.addEventListener('click', () => goLineas(-1));
  document.querySelector('[data-lines-next]')?.addEventListener('click', () => goLineas(1));

  linesDots.forEach((dot, i) => {
    dot.addEventListener('click', () => setLineasSlide(i));
  });

  window.addEventListener('keydown', (event) => {
    if (!lineasInView()) return;
    const target = event.target as HTMLElement | null;
    if (target && (target.closest('input, textarea, select, [contenteditable="true"]'))) return;
    if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
      event.preventDefault();
      goLineas(-1);
    } else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
      event.preventDefault();
      goLineas(1);
    }
  });

  // Section is pinned (filling the viewport) once its top lines up with the
  // page top — that's the moment scroll should drive panels instead of the page.
  const isLineasPinned = () => {
    if (!linesShowcase) return false;
    const rect = linesShowcase.getBoundingClientRect();
    return Math.abs(rect.top) < 2 && rect.height > 0;
  };

  const atFirstPanel = () => currentIndex === 0;
  const atLastPanel = () => currentIndex === PANEL_COUNT - 1;

  // Custom stepped scroll: while pinned, wheel input advances one panel at a
  // time (with a resistance threshold + lock) instead of scrolling the page.
  // At the first/last panel, scroll passes through untouched to the next section.
  const WHEEL_STEP_PX = 42;
  const WHEEL_LOCK_MS = 640;
  let wheelAccum = 0;
  let wheelLocked = false;

  const onLineasWheel = (event: WheelEvent) => {
    if (!isLineasPinned()) {
      wheelAccum = 0;
      return;
    }

    const dy = event.deltaY;
    if (Math.abs(dy) < 1) return;

    if (dy < 0 && atFirstPanel()) {
      wheelAccum = 0;
      return;
    }
    if (dy > 0 && atLastPanel()) {
      wheelAccum = 0;
      return;
    }

    event.preventDefault();
    if (wheelLocked) return;

    wheelAccum += dy;
    if (Math.abs(wheelAccum) < WHEEL_STEP_PX) return;

    const dir = wheelAccum > 0 ? 1 : -1;
    wheelAccum = 0;
    wheelLocked = true;
    goLineas(dir);
    window.setTimeout(() => {
      wheelLocked = false;
    }, WHEEL_LOCK_MS);
  };

  window.addEventListener('wheel', onLineasWheel, { passive: false });

  let swipeX = 0;
  let swipeY = 0;
  let swipeActive = false;

  linesViewport?.addEventListener('pointerdown', (event) => {
    swipeActive = true;
    swipeX = event.clientX;
    swipeY = event.clientY;
  });

  const endSwipe = (event: PointerEvent) => {
    if (!swipeActive) return;
    swipeActive = false;
    if (!isLineasPinned()) return;

    const dy = event.clientY - swipeY;
    const dx = event.clientX - swipeX;
    if (Math.abs(dy) < 48 || Math.abs(dy) < Math.abs(dx) * 1.15) return;

    const dir = dy < 0 ? 1 : -1;
    if ((dir === 1 && atLastPanel()) || (dir === -1 && atFirstPanel())) return;
    goLineas(dir);
  };

  linesViewport?.addEventListener('pointerup', endSwipe);
  linesViewport?.addEventListener('pointercancel', () => {
    swipeActive = false;
  });

  const slugToIndex = (slug: string) => lineSlugs.indexOf(slug);

  const applyLineasHash = (hash = window.location.hash) => {
    const id = hash.replace('#', '');
    const idx = slugToIndex(id);
    if (idx >= 0) setLineasSlide(idx);
  };

  window.addEventListener('df:lineas-go', (event) => {
    const slug = (event as CustomEvent<{ slug?: string }>).detail?.slug;
    if (typeof slug === 'string') applyLineasHash(`#${slug}`);
  });

  window.addEventListener('hashchange', () => applyLineasHash());
  window.addEventListener('scroll', () => {
    document.documentElement.classList.toggle('is-lineas-active', lineasInView());
  }, { passive: true });

  setLineasSlide(0, true);
  applyLineasHash();
</script>

<style>
  .home-atmosphere {
    position: fixed;
    top: var(--nav-height);
    right: 0;
    width: 50%;
    height: calc(100vh - var(--nav-height));
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .home-atmosphere :global(.atmosphere) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .home-atmosphere :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    cursor: default;
  }

  .home-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      color-mix(in srgb, var(--void) 88%, transparent) 18%,
      transparent 42%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    box-sizing: border-box;
    min-height: var(--home-section-min-h);
    height: var(--home-section-min-h);
    padding: var(--nav-height) 0 clamp(2.5rem, 5vh, 4rem);
    overflow: hidden;
  }

  .hero__shield {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      var(--void) 78%,
      color-mix(in srgb, var(--void) 92%, transparent) 92%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 32rem;
  }

  .hero__eyebrow {
    color: var(--mute);
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    max-width: 42ch;
    margin-bottom: 2.25rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .hero__visual {
    position: relative;
    min-height: clamp(16rem, 38vh, 26rem);
    align-self: center;
    justify-self: end;
    width: 100%;
    max-width: 28rem;
    pointer-events: none;
  }

  .about {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: var(--home-section-min-h);
    height: var(--home-section-min-h);
    padding-block: 0;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .about__inner {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    /* When content is taller than the available space, plain `center`
       overflows both ways — pushing the top past the tagline strip above
       it. `safe center` falls back to start-alignment instead. */
    justify-content: center;
    justify-content: safe center;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }

  .crafts,
  .contact {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: var(--home-section-min-h);
    height: var(--home-section-min-h);
    padding-block: 0;
    padding-top: var(--nav-height);
    overflow: hidden;
  }

  .crafts > .container,
  .contact > .container {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    padding-block: clamp(1.5rem, 4vh, 3rem);
  }

  /* Short viewports (landscape phones, small browser windows): a forced
     100dvh section clips real content there — fall back to natural height
     and plain scroll instead of fighting the layout to fit one screen. */
  @media (max-height: 500px) {
    .hero,
    .about,
    .lines-showcase,
    .crafts,
    .contact {
      height: auto;
      min-height: 100vh;
      overflow: visible;
    }

    .lines-showcase__stage {
      overflow: visible;
    }
  }

  @media (max-width: 959px) {
    .lines-showcase__copy {
      max-width: none;
      padding-right: 0;
    }

    .lines-showcase__controls {
      justify-content: flex-start;
      padding-bottom: 1.25rem;
    }

    .home-atmosphere {
      width: 100%;
      height: min(16vh, 140px);
      top: auto;
      bottom: 0;
      opacity: 0.6;
    }

    .hero {
      min-height: var(--home-section-min-h);
      height: var(--home-section-min-h);
      padding-top: var(--nav-height);
      padding-bottom: min(18vh, 160px);
    }

    .about,
    .crafts,
    .contact {
      min-height: var(--home-section-min-h);
      height: var(--home-section-min-h);
      padding-bottom: min(18vh, 160px);
      /* Content length varies (about's 3 paragraphs vs crafts' 4 cards) —
         when it doesn't fit, scroll inside the section instead of a fixed
         overflow:hidden silently hiding whatever ran past the fold. */
      overflow-y: auto;
    }

    .lines-showcase__stage {
      padding-bottom: min(18vh, 160px);
    }

    .hero__shield {
      width: 100%;
      height: 58%;
      background: linear-gradient(
        180deg,
        var(--void) 0%,
        var(--void) 70%,
        color-mix(in srgb, var(--void) 92%, transparent) 86%,
        transparent 100%
      );
    }

    .hero__visual {
      min-height: 2.75rem;
      max-width: none;
      order: 2;
      pointer-events: none;
    }

    .hero__copy {
      order: 1;
    }
  }

  .hero-enter__item {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
  }

  .hero-enter.is-loaded .hero-enter__item {
    animation: hero-enter 820ms var(--ease-out) both;
    animation-delay: calc(var(--enter-i, 0) * 110ms);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(32px);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .tagline-strip {
    position: relative;
    z-index: 1;
    border-block: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding: 1.1rem 0;
    overflow: hidden;
  }

  .tagline-strip p {
    max-width: none;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--fog);
    text-transform: uppercase;
  }

  .about__title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: var(--space-md);
    max-width: 16ch;
  }

  .about__body {
    display: grid;
    gap: 1.35rem;
  }

  .about__body p {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.15rem);
    line-height: 1.75;
    max-width: 58ch;
  }

  .lines-showcase {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    min-height: var(--home-section-min-h);
    height: var(--home-section-min-h);
    overflow: hidden;
    --lines-index: 0;
  }

  .lines-showcase__stage {
    height: 100%;
    box-sizing: border-box;
    padding-top: var(--nav-height);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }

  .lines-showcase__header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem 0.65rem;
  }

  .lines-showcase__counter {
    font-family: var(--font-display);
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .lines-showcase__viewport {
    position: relative;
    overflow: hidden;
    min-height: 0;
    touch-action: pan-y;
  }

  .lines-showcase__track {
    display: flex;
    height: 100%;
    width: calc(var(--lineas-panel-count) * 100%);
    transform: translate3d(calc(var(--lines-index) * -100% / var(--lineas-panel-count)), 0, 0);
    transition: transform 520ms var(--ease-out);
  }

  .lines-showcase__panel {
    flex: 0 0 calc(100% / var(--lineas-panel-count));
    width: calc(100% / var(--lineas-panel-count));
    height: 100%;
    display: flex;
    align-items: center;
    padding-block: 1rem 1.5rem;
    opacity: 0.38;
    pointer-events: none;
    transition: opacity 280ms var(--ease-out);
  }

  .lines-showcase__panel.is-active {
    z-index: 1;

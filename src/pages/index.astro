---
import BaseLayout from '../layouts/BaseLayout.astro';
import Atmosphere from '../components/Atmosphere';
import ScrollProgress from '../components/ScrollProgress.astro';
import { lines } from '../data/lines';

const crafts = [
  {
    title: 'Diseño',
    copy: 'Identidad, interfaces y sistemas con jerarquía cinematográfica.',
  },
  {
    title: 'Desarrollo',
    copy: 'Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.',
  },
  {
    title: 'Arte',
    copy: 'Dirección de arte y motion que sostienen el mundo de la marca.',
  },
  {
    title: 'Producción',
    copy: 'De concepto a entrega, con ritmo de estudio.',
  },
];

const stats = [
  { value: '04', label: 'líneas bajo una pluma' },
  { value: '4', label: 'oficios en el taller' },
];
---

<BaseLayout title="Dark Feather Group">
  <ScrollProgress />

  <div class="home-atmosphere" aria-hidden="true">
    <Atmosphere client:load />
  </div>

  <section id="inicio" class="hero">
    <div class="hero__shield" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy hero-enter">
        <p class="hero__eyebrow hero-enter__item" style="--enter-i: 0">Dark Feather Group</p>
        <h1 class="hero__title">
          <span class="hero-enter__item" style="--enter-i: 1">Diseñado para</span>
          <span class="hero-enter__item" style="--enter-i: 2">significar algo.</span>
        </h1>
        <p class="hero__lead hero-enter__item" style="--enter-i: 3">
          Cuatro líneas, un mismo oficio. Estudio creativo noir — hosting, series,
          taller y voces bajo una sola pluma.
        </p>
        <div class="hero__actions hero-enter__item" style="--enter-i: 4">
          <a class="btn btn--solid" href="#contacto">Empezar proyecto</a>
          <button
            class="hero__dare"
            type="button"
            data-feather-dare
            aria-label="Interactuar con la pluma de puntos"
          >
            Tocá la pluma · <span data-feather-dare-hint>osá acercarte</span>
          </button>
        </div>
      </div>

      <div class="hero__visual" data-feather-zone aria-hidden="true"></div>
    </div>
  </section>

  <div class="tagline-strip reveal" data-reveal aria-hidden="true">
    <p>Sombra·Oficio·Presencia</p>
  </div>

  <section id="grupo" class="section about">
    <div class="container about__inner">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Grupo</p>
      <h2 class="about__title reveal" data-reveal>El colectivo detrás de la pluma.</h2>
      <div class="about__body" data-reveal-group>
        <p class="reveal" data-reveal>
          Dark Feather Group es un estudio creativo que trabaja a contraluz: menos
          ruido, más atmósfera. Diseñamos identidades, desarrollamos experiencias
          web, producimos arte y sonido — siempre con la misma dirección de arte.
        </p>
        <p class="reveal" data-reveal>
          No somos una fábrica de plantillas ni un launch deck con números
          inflados. Somos cuatro líneas de producto — hosting, series, taller y
          voces — que comparten un lenguaje visual noir y un criterio editorial.
        </p>
        <p class="reveal" data-reveal>
          Cada proyecto busca significar algo: una marca que se siente habitada,
          una serie que respira en capítulos, una web que no parece un catálogo
          genérico. Ese es el oficio.
        </p>
      </div>
    </div>
  </section>

  <section class="section facts" aria-label="Cifras del estudio">
    <div class="container">
      <div class="facts__grid" data-reveal-group>
        {stats.map((stat) => (
          <article class="fact reveal" data-reveal>
            <span class="fact__value">{stat.value}</span>
            <span class="fact__label">{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="lineas" class="section lines" aria-label="Líneas del grupo">
    <div class="container">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Líneas</p>
      <h2 class="lines__title reveal" data-reveal>Cuatro frentes bajo una pluma.</h2>
      <p class="lines__lead reveal" data-reveal>
        Cada código DF resuelve un frente distinto del universo creativo.
      </p>

      <div class="lines__list" data-reveal-group>
        {
          lines.map((line) => (
            <article class="line-card reveal" id={line.slug} data-reveal>
              <div class="line-card__head">
                <h3 class="line-card__code">{line.code}</h3>
                <p class="line-card__tag">{line.tagline}</p>
              </div>
              <p class="line-card__summary">{line.summary}</p>
              <ul class="line-card__points">
                {line.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="oficio" class="section crafts">
    <div class="container">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Oficio</p>
      <h2 class="crafts__title reveal" data-reveal>Oficio con atmósfera.</h2>
      <p class="crafts__lead reveal" data-reveal>
        Lo que hacemos cuando la pluma baja al papel — o al código.
      </p>

      <div class="crafts__grid" data-reveal-group>
        {
          crafts.map((item) => (
            <article class="craft-card reveal" data-reveal>
              <h3 class="craft-card__title">{item.title}</h3>
              <p class="craft-card__copy">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section contact">
    <div class="container contact__inner" data-reveal-group>
      <p class="section-eyebrow reveal reveal--left" data-reveal>Contacto</p>
      <h2 class="contact__title reveal" data-reveal>Hablemos.</h2>
      <p class="contact__lead reveal" data-reveal>
        Contanos qué línea te interesa y cómo suena el proyecto. Respondemos con
        criterio, no con un bot.
      </p>
      <a class="btn btn--solid contact__cta reveal" data-reveal href="mailto:hola@darkfeathergroup.com">
        hola@darkfeathergroup.com
      </a>
      <p class="contact__hint reveal" data-reveal>Correo de ejemplo · reemplazar con el canal real.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const dispatchFeather = (intensity: number) => {
    window.dispatchEvent(
      new CustomEvent('df:feather-interact', { detail: { intensity } }),
    );
  };

  const featherZone = document.querySelector('[data-feather-zone]');
  const featherDare = document.querySelector('[data-feather-dare]');
  const dareHint = document.querySelector('[data-feather-dare-hint]');

  const bindFeather = (el: Element | null, hoverOnly = false) => {
    if (!el || reduceMotion) return;

    el.addEventListener('pointerenter', () => {
      dispatchFeather(1);
      dareHint && (dareHint.textContent = 'la pluma responde');
    });
    el.addEventListener('pointerleave', () => dispatchFeather(0));
    el.addEventListener('pointermove', () => dispatchFeather(1));

    if (!hoverOnly) {
      el.addEventListener('pointerdown', () => dispatchFeather(1.4));
      el.addEventListener('pointerup', () => dispatchFeather(0.8));
    }
  };

  bindFeather(featherZone);
  bindFeather(featherDare, true);

  document.querySelectorAll('[data-reveal-group]').forEach((group) => {
    group.querySelectorAll('[data-reveal]').forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${i * 100}ms`);
    });
  });

  if (!reduceMotion) {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');

    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('is-visible');
    });
  }
</script>

<style>
  .home-atmosphere {
    position: fixed;
    top: 0;
    right: 0;
    width: min(52%, 760px);
    height: 100svh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .home-atmosphere :global(.atmosphere),
  .home-atmosphere :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      color-mix(in srgb, var(--void) 88%, transparent) 18%,
      transparent 42%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7rem 0 5rem;
    overflow: hidden;
  }

  .hero__shield {
    position: absolute;
    top: 0;
    left: 0;
    width: min(58%, 680px);
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      var(--void) 78%,
      color-mix(in srgb, var(--void) 92%, transparent) 92%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 36rem;
  }

  .hero__eyebrow {
    color: var(--mute);
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    max-width: 42ch;
    margin-bottom: 2.25rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .hero__dare {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--mute);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    padding: 0;
    transition: color 200ms var(--ease-out);
  }

  .hero__dare:hover,
  .hero__dare:focus-visible {
    color: var(--bone);
  }

  .hero__visual {
    position: relative;
    min-height: clamp(14rem, 32vw, 22rem);
    pointer-events: auto;
    cursor: crosshair;
  }

  @media (max-width: 959px) {
    .home-atmosphere {
      width: 100%;
      height: min(42svh, 360px);
      top: auto;
      bottom: 0;
      opacity: 0.85;
    }

    .hero__shield {
      width: 100%;
      height: 62%;
      background: linear-gradient(
        180deg,
        var(--void) 0%,
        var(--void) 72%,
        color-mix(in srgb, var(--void) 90%, transparent) 88%,
        transparent 100%
      );
    }

    .hero__visual {
      min-height: 0;
      pointer-events: none;
    }
  }

  .hero-enter__item {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
  }

  .hero-enter.is-loaded .hero-enter__item {
    animation: hero-enter 820ms var(--ease-out) both;
    animation-delay: calc(var(--enter-i, 0) * 110ms);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(32px);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .tagline-strip {
    position: relative;
    z-index: 1;
    border-block: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding: 1.1rem 0;
    overflow: hidden;
  }

  .tagline-strip p {
    max-width: none;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--fog);
    text-transform: uppercase;
  }

  .about__inner {
    max-width: 52rem;
  }

  .about__title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: var(--space-md);
    max-width: 16ch;
  }

  .about__body {
    display: grid;
    gap: 1.35rem;
  }

  .about__body p {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.15rem);
    line-height: 1.75;
    max-width: 58ch;
  }

  .facts__grid {
    display: grid;
    gap: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding-top: var(--space-lg);
  }

  .fact__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin-bottom: 0.5rem;
  }

  .fact__label {
    color: var(--mute);
    font-size: 0.88rem;
    max-width: 22ch;
  }

  .lines__title,
  .crafts__title,
  .contact__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    max-width: 16ch;
    margin-bottom: 1rem;
  }

  .lines__lead,
  .crafts__lead,
  .contact__lead {
    color: var(--fog);
    font-size: 1.08rem;
    max-width: 48ch;
    margin-bottom: var(--space-lg);
  }

  .lines__list {
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .line-card {
    padding: 2.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
  }

  .line-card__code {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .line-card__tag {
    color: var(--ember-hot);
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .line-card__summary {
    color: var(--fog);
    max-width: 52ch;
    margin-bottom: 1.25rem;
  }

  .line-card__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .line-card__points li {
    color: var(--mute);
    font-size: 0.95rem;
    padding-left: 1rem;
    position: relative;
  }

  .line-card__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--ember);
  }

  .crafts__grid {
    display: grid;
    gap: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding-top: var(--space-md);
  }

  .craft-card__title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .craft-card__copy {
    color: var(--fog);
    max-width: 40ch;
  }

  .contact__inner {
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
  }

  .contact__lead {
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .contact__hint {
    margin-top: 1rem;
    color: var(--mute);
    font-size: 0.9rem;
    max-width: none;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }

    .hero__visual {
      min-height: clamp(18rem, 50vh, 32rem);
    }

    .facts__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    .crafts__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter__item {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Atmosphere from '../components/Atmosphere';
import ScrollProgress from '../components/ScrollProgress.astro';
import { lines } from '../data/lines';

const crafts = [
  {
    title: 'Diseño',
    copy: 'Identidad, interfaces y sistemas con jerarquía cinematográfica.',
  },
  {
    title: 'Desarrollo',
    copy: 'Webs y experiencias: Astro, React, WebGL cuando la idea lo pide.',
  },
  {
    title: 'Arte',
    copy: 'Dirección de arte y motion que sostienen el mundo de la marca.',
  },
  {
    title: 'Producción',
    copy: 'De concepto a entrega, con ritmo de estudio.',
  },
];

const stats = [
  { value: '04', label: 'líneas bajo una pluma' },
  { value: '4', label: 'oficios en el taller' },
];
---

<BaseLayout title="Dark Feather Group">
  <ScrollProgress />

  <div class="home-atmosphere" aria-hidden="true">
    <Atmosphere client:load />
  </div>

  <section id="inicio" class="hero">
    <div class="hero__shield" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy hero-enter">
        <p class="hero__eyebrow hero-enter__item" style="--enter-i: 0">Dark Feather Group</p>
        <h1 class="hero__title">
          <span class="hero-enter__item" style="--enter-i: 1">Diseñado para</span>
          <span class="hero-enter__item" style="--enter-i: 2">significar algo.</span>
        </h1>
        <p class="hero__lead hero-enter__item" style="--enter-i: 3">
          Cuatro líneas, un mismo oficio. Estudio creativo noir — hosting, series,
          taller y voces bajo una sola pluma.
        </p>
        <div class="hero__actions hero-enter__item" style="--enter-i: 4">
          <a class="btn btn--solid" href="#contacto">Empezar proyecto</a>
          <button
            class="hero__dare"
            type="button"
            data-feather-dare
            aria-label="Mantené presionado para activar la pluma de puntos"
          >
            <span class="hero__dare-ring" aria-hidden="true"></span>
            <span class="hero__dare-label">
              Tocá la pluma · <span data-feather-dare-hint>mantené presionado</span>
            </span>
          </button>
        </div>
      </div>

      <div class="hero__visual" data-feather-zone aria-hidden="true"></div>
    </div>
  </section>

  <div class="tagline-strip reveal" data-reveal aria-hidden="true">
    <p>Sombra·Oficio·Presencia</p>
  </div>

  <section id="grupo" class="section about">
    <div class="container about__inner">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Grupo</p>
      <h2 class="about__title reveal" data-reveal>El colectivo detrás de la pluma.</h2>
      <div class="about__body" data-reveal-group>
        <p class="reveal" data-reveal>
          Dark Feather Group es un estudio creativo que trabaja a contraluz: menos
          ruido, más atmósfera. Diseñamos identidades, desarrollamos experiencias
          web, producimos arte y sonido — siempre con la misma dirección de arte.
        </p>
        <p class="reveal" data-reveal>
          No somos una fábrica de plantillas ni un launch deck con números
          inflados. Somos cuatro líneas de producto — hosting, series, taller y
          voces — que comparten un lenguaje visual noir y un criterio editorial.
        </p>
        <p class="reveal" data-reveal>
          Cada proyecto busca significar algo: una marca que se siente habitada,
          una serie que respira en capítulos, una web que no parece un catálogo
          genérico. Ese es el oficio.
        </p>
      </div>
    </div>
  </section>

  <section class="section facts" aria-label="Cifras del estudio">
    <div class="container">
      <div class="facts__grid" data-reveal-group>
        {stats.map((stat) => (
          <article class="fact reveal" data-reveal>
            <span class="fact__value">{stat.value}</span>
            <span class="fact__label">{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="lineas" class="lines-showcase" data-lines-showcase aria-label="Líneas del grupo">
    <div class="lines-showcase__sticky">
      <header class="lines-showcase__header container">
        <p class="section-eyebrow">Líneas</p>
        <p class="lines-showcase__counter" data-lines-counter aria-live="polite">01 — DF Hosting</p>
      </header>

      <div class="lines-showcase__viewport">
        <div class="lines-showcase__track" data-lines-track>
          {
            lines.map((line, i) => (
              <article
                class="lines-showcase__panel"
                id={line.slug}
                data-panel={i}
                aria-label={line.code}
              >
                <div class="lines-showcase__copy container">
                  <span class="lines-showcase__index">{String(i + 1).padStart(2, '0')}</span>
                  <h2 class="lines-showcase__code">{line.code}</h2>
                  <p class="lines-showcase__tag">{line.tagline}</p>
                  <p class="lines-showcase__summary">{line.summary}</p>
                  <ul class="lines-showcase__points">
                    {line.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="lines-showcase__progress" aria-hidden="true">
        {
          lines.map((line, i) => (
            <span class="lines-showcase__dot" data-lines-dot={i} />
          ))
        }
      </div>
      <p class="lines-showcase__hint">Scroll para recorrer las líneas</p>
    </div>
  </section>

  <section id="oficio" class="section crafts">
    <div class="container">
      <p class="section-eyebrow reveal reveal--left" data-reveal>Oficio</p>
      <h2 class="crafts__title reveal" data-reveal>Oficio con atmósfera.</h2>
      <p class="crafts__lead reveal" data-reveal>
        Lo que hacemos cuando la pluma baja al papel — o al código.
      </p>

      <div class="crafts__grid" data-reveal-group>
        {
          crafts.map((item) => (
            <article class="craft-card card-interactive reveal" data-reveal>
              <h3 class="craft-card__title">{item.title}</h3>
              <p class="craft-card__copy">{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section contact">
    <div class="container contact__inner" data-reveal-group>
      <p class="section-eyebrow reveal reveal--left" data-reveal>Contacto</p>
      <h2 class="contact__title reveal" data-reveal>Hablemos.</h2>
      <p class="contact__lead reveal" data-reveal>
        Contanos qué línea te interesa y cómo suena el proyecto. Respondemos con
        criterio, no con un bot.
      </p>
      <a class="btn btn--solid contact__cta reveal" data-reveal href="mailto:hola@darkfeathergroup.com">
        hola@darkfeathergroup.com
      </a>
      <p class="contact__hint reveal" data-reveal>Correo de ejemplo · reemplazar con el canal real.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  type FeatherDetail = { intensity?: number; burst?: boolean; hold?: number };

  const dispatchFeather = (detail: FeatherDetail) => {
    window.dispatchEvent(new CustomEvent('df:feather-interact', { detail }));
  };

  const featherZone = document.querySelector('[data-feather-zone]');
  const featherDare = document.querySelector('[data-feather-dare]') as HTMLElement | null;
  const dareHint = document.querySelector('[data-feather-dare-hint]');

  const HOLD_MS = 520;

  const bindHold = (el: HTMLElement | null, opts: { showRing?: boolean } = {}) => {
    if (!el) return;

    let holdTimer: ReturnType<typeof setTimeout> | null = null;
    let holdStart = 0;
    let rafId = 0;
    let bursting = false;

    const setProgress = (value: number) => {
      if (opts.showRing) el.style.setProperty('--hold-progress', String(value));
    };

    const clearHold = () => {
      if (holdTimer) clearTimeout(holdTimer);
      holdTimer = null;
      cancelAnimationFrame(rafId);
      el.classList.remove('is-holding', 'is-burst');
      setProgress(0);
      if (!bursting) dispatchFeather({ intensity: 0, hold: 0 });
    };

    const tickHold = () => {
      const progress = Math.min((performance.now() - holdStart) / HOLD_MS, 1);
      setProgress(progress);
      dispatchFeather({ intensity: 0.28 + progress * 0.5, hold: progress });
      if (progress < 1) rafId = requestAnimationFrame(tickHold);
    };

    const triggerBurst = () => {
      bursting = true;
      el.classList.add('is-burst');
      if (dareHint) dareHint.textContent = '¡la pluma estalla!';
      dispatchFeather({ intensity: 1.5, burst: true, hold: 1 });
      window.setTimeout(() => {
        bursting = false;
        el.classList.remove('is-burst', 'is-holding');
        setProgress(0);
        if (dareHint) dareHint.textContent = 'mantené presionado';
        dispatchFeather({ intensity: 0.2, hold: 0 });
        window.setTimeout(() => dispatchFeather({ intensity: 0, hold: 0 }), 400);
      }, 680);
    };

    el.addEventListener('pointerdown', (e) => {
      if (reduceMotion) {
        triggerBurst();
        return;
      }
      holdStart = performance.now();
      el.classList.add('is-holding');
      el.setPointerCapture(e.pointerId);
      tickHold();
      holdTimer = setTimeout(triggerBurst, HOLD_MS);
    });

    el.addEventListener('pointerup', () => {
      if (!bursting) clearHold();
    });
    el.addEventListener('pointercancel', () => {
      if (!bursting) clearHold();
    });
    el.addEventListener('pointerleave', () => {
      if (!bursting && !el.classList.contains('is-holding')) {
        dispatchFeather({ intensity: 0, hold: 0 });
      }
    });

    if (finePointer && !reduceMotion) {
      el.addEventListener('pointerenter', () => {
        if (!el.classList.contains('is-holding')) dispatchFeather({ intensity: 0.22 });
      });
      el.addEventListener('pointerleave', () => {
        if (!el.classList.contains('is-holding') && !bursting) dispatchFeather({ intensity: 0, hold: 0 });
      });
    }
  };

  bindHold(featherDare, { showRing: true });
  bindHold(featherZone as HTMLElement | null);

  document.querySelectorAll('[data-reveal-group]').forEach((group) => {
    group.querySelectorAll('[data-reveal]').forEach((el, i) => {
      el.style.setProperty('--reveal-delay', `${i * 90}ms`);
    });
  });

  if (!reduceMotion) {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');

    const items = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -4% 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    document.querySelector('.hero-enter')?.classList.add('is-loaded');
    document.querySelectorAll('[data-reveal]').forEach((el) => {
      el.classList.add('is-visible');
    });
  }

  const linesShowcase = document.querySelector('[data-lines-showcase]') as HTMLElement | null;
  const linesTrack = document.querySelector('[data-lines-track]') as HTMLElement | null;
  const linesCounter = document.querySelector('[data-lines-counter]');
  const linesDots = document.querySelectorAll('[data-lines-dot]');
  const lineLabels = ['DF Hosting', 'DF Series', 'DF Atelier', 'DF Voices'];

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

  const updateLineasScroll = () => {
    if (!linesShowcase || !linesTrack) return;

    const vh = window.innerHeight;
    const rect = linesShowcase.getBoundingClientRect();
    const scrollable = linesShowcase.offsetHeight - vh;
    const raw = scrollable > 0 ? clamp(-rect.top / scrollable, 0, 1) : 0;
    const progress = raw * 3;
    const index = Math.min(3, Math.floor(progress + 0.001));
    const frac = progress - index;

    if (!reduceMotion) {
      linesTrack.style.transform = `translate3d(${-raw * 75}%, 0, 0)`;
    }

    if (linesCounter) {
      linesCounter.textContent = `${String(index + 1).padStart(2, '0')} — ${lineLabels[index]}`;
    }

    linesDots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
      dot.classList.toggle('is-near', Math.abs(i - progress) < 0.55);
    });

    document.documentElement.classList.toggle('is-lineas-active', rect.top < vh * 0.35 && rect.bottom > vh * 0.35);

    window.dispatchEvent(
      new CustomEvent('df:lineas-panel', {
        detail: { index, frac, progress, raw },
      }),
    );
  };

  updateLineasScroll();
  window.addEventListener('scroll', updateLineasScroll, { passive: true });
  window.addEventListener('resize', updateLineasScroll, { passive: true });
</script>

<style>
  .home-atmosphere {
    position: fixed;
    top: var(--nav-height);
    right: 0;
    width: min(48%, 680px);
    height: calc(100svh - var(--nav-height));
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .home-atmosphere :global(.atmosphere),
  .home-atmosphere :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      color-mix(in srgb, var(--void) 88%, transparent) 18%,
      transparent 42%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero {
    position: relative;
    z-index: 1;
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5.5rem 0 4rem;
    overflow: hidden;
  }

  .hero__shield {
    position: absolute;
    top: 0;
    left: 0;
    width: min(58%, 680px);
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--void) 0%,
      var(--void) 78%,
      color-mix(in srgb, var(--void) 92%, transparent) 92%,
      transparent 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero__copy {
    max-width: 32rem;
  }

  .hero__eyebrow {
    color: var(--mute);
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(3rem, 9vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
  }

  .hero__title span {
    display: block;
  }

  .hero__lead {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    max-width: 42ch;
    margin-bottom: 2.25rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .hero__dare {
    position: relative;
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--mute);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0.35rem 0.5rem 0.35rem 2.35rem;
    transition:
      color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .hero__dare-ring {
    --hold-progress: 0;
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.65rem;
    height: 1.65rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: conic-gradient(
      var(--ember-hot) calc(var(--hold-progress) * 360deg),
      color-mix(in srgb, var(--bone) 12%, transparent) 0
    );
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }

  .hero__dare-ring::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--void);
  }

  .hero__dare.is-holding .hero__dare-ring {
    opacity: 1;
  }

  .hero__dare.is-burst {
    color: var(--bone);
    transform: scale(1.03);
  }

  .hero__dare:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__dare:hover {
      color: var(--bone);
    }
  }

  .hero__visual {
    position: relative;
    min-height: clamp(16rem, 38vh, 26rem);
    align-self: center;
    justify-self: end;
    width: 100%;
    max-width: 28rem;
    pointer-events: auto;
    cursor: pointer;
    touch-action: manipulation;
  }

  @media (max-width: 959px) {
    .lines-showcase {
      height: 360svh;
    }

    .lines-showcase__copy {
      max-width: none;
      padding-right: 0;
    }

    .lines-showcase__hint {
      right: 1.25rem;
      bottom: 1.25rem;
    }

    .lines-showcase__progress {
      bottom: 1.25rem;
      left: 1.25rem;
      transform: none;
    }

    .home-atmosphere {
      width: 100%;
      height: min(38svh, 320px);
      top: auto;
      bottom: 0;
      opacity: 0.88;
    }

    .hero {
      padding-bottom: min(38svh, 320px);
    }

    .hero__shield {
      width: 100%;
      height: 58%;
      background: linear-gradient(
        180deg,
        var(--void) 0%,
        var(--void) 70%,
        color-mix(in srgb, var(--void) 92%, transparent) 86%,
        transparent 100%
      );
    }

    .hero__visual {
      min-height: 2.75rem;
      max-width: none;
      order: 2;
      pointer-events: auto;
    }

    .hero__copy {
      order: 1;
    }
  }

  .hero-enter__item {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
  }

  .hero-enter.is-loaded .hero-enter__item {
    animation: hero-enter 820ms var(--ease-out) both;
    animation-delay: calc(var(--enter-i, 0) * 110ms);
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(32px);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .tagline-strip {
    position: relative;
    z-index: 1;
    border-block: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding: 1.1rem 0;
    overflow: hidden;
  }

  .tagline-strip p {
    max-width: none;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--fog);
    text-transform: uppercase;
  }

  .about__inner {
    max-width: 52rem;
  }

  .about__title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin-bottom: var(--space-md);
    max-width: 16ch;
  }

  .about__body {
    display: grid;
    gap: 1.35rem;
  }

  .about__body p {
    color: var(--fog);
    font-size: clamp(1.05rem, 2vw, 1.15rem);
    line-height: 1.75;
    max-width: 58ch;
  }

  .facts__grid {
    display: grid;
    gap: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 8%, transparent);
    padding-top: var(--space-lg);
  }

  .fact__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    margin-bottom: 0.5rem;
  }

  .fact__label {
    color: var(--mute);
    font-size: 0.88rem;
    max-width: 22ch;
  }

  .lines-showcase {
    position: relative;
    height: 400svh;
    z-index: 1;
  }

  .lines-showcase__sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
  }

  .lines-showcase__header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem 0.75rem;
  }

  .lines-showcase__counter {
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .lines-showcase__viewport {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .lines-showcase__track {
    display: flex;
    height: 100%;
    width: 400%;
    will-change: transform;
    transition: transform 80ms linear;
  }

  .lines-showcase__panel {
    flex: 0 0 25%;
    width: 25%;
    height: 100%;
    display: flex;
    align-items: center;
    padding-block: 1rem 3rem;
  }

  .lines-showcase__copy {
    max-width: min(36rem, 52vw);
    padding-right: 1.5rem;
  }

  .lines-showcase__index {
    display: block;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: var(--mute);
    margin-bottom: 1rem;
  }

  .lines-showcase__code {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 0.75rem;
  }

  .lines-showcase__tag {
    color: var(--ember-hot);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .lines-showcase__summary {
    color: var(--fog);
    font-size: clamp(1.02rem, 2vw, 1.12rem);
    line-height: 1.72;
    max-width: 46ch;
    margin-bottom: 1.5rem;
  }

  .lines-showcase__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .lines-showcase__points li {
    color: var(--mute);
    font-size: 0.95rem;
    padding-left: 1rem;
    position: relative;
    max-width: 44ch;
  }

  .lines-showcase__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--ember);
  }

  .lines-showcase__progress {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.55rem;
    z-index: 2;
  }

  .lines-showcase__dot {
